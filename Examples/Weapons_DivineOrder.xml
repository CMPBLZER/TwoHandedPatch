<!-- ==================== Pistol =================== -->


<ThingDef ParentName="BaseHumanMakeableGun">
    <defName>BotchJob_DivineOrderPistol</defName>
    <label>divine order pistol</label>
    <description>An ornate pistol with a flintlock firing mechanism. It fires a powerful shot that can pierce most conventional armor but is slow to reload.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/DivineOrderPistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	<drawSize>0.9</drawSize>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <soundInteract>Interact_Revolver</soundInteract>
    <statBases>
      <WorkToMake>25000</WorkToMake>
      <Mass>2</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown>
    </statBases>
     <weaponTags>
         <li>BotchJob_DivineOrderPistol</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
	<tradeTags>
	<li>BotchJob_DivineOrderWeapon</li>
	</tradeTags>
    <costList>
	<WoodLog>100</WoodLog>
      <Steel>50</Steel>
      <Gold>5</Gold>
	<DankPyon_ComponentBasic MayRequire="DankPyon.Medieval.Overhaul">2</DankPyon_ComponentBasic>
    </costList>
    <recipeMaker>
	<researchPrerequisite Inherit="False">BotchJob_DivineOrderSmithing</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>400</displayPriority>
	  <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
	<li MayRequire="DankPyon.Medieval.Overhaul">DankPyon_Anvil</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>BotchJob_DivineOrderPistolBullet</defaultProjectile>
        <warmupTime>1.2</warmupTime>
        <range>20</range>
        <soundCast>BotchJob_DivineOrderPistolShot</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
	
  </ThingDef>


